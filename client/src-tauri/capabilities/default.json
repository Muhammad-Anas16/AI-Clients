{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "JARVIS desktop client capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:3000/**"
        },
        {
          "url": "http://localhost:3000/**"
        }
      ]
    }
  ]
}
